{
  "name": "dsh-hyrealai-fde",
  "version": "0.1.3",
  "type": "module",
  "description": "Hyreal FDE 企业工作台 dsh 插件——在 DeepSeek Harness 内提供结构化工作台界面与平台能力；数据经 MCP（工具）与同源代理（页面）取自 ai-fde 平台",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm sync:skills && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
